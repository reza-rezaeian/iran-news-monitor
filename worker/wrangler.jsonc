{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iran-news",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "account_id": "6f4bdb35b2d88c4c5af36d9e7a98deb9",
  "assets": {
    "directory": "../public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iran-news",
      "database_id": "daaf4460-493c-4536-a2df-efa10179376d"
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "*/5 * * * *", "*/10 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
